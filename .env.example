# --- Database (Neon) ---
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Anthropic (for summarization) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail OAuth ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCOUNTS=personal,work
GMAIL_REFRESH_TOKEN_PERSONAL=
GMAIL_REFRESH_TOKEN_WORK=

# --- Microsoft Graph (Outlook + Teams) ---
# MS_CLIENT_ID and MS_TENANT_ID are non-secret app config; store as GitHub vars.
# MS_REFRESH_TOKEN_* are secrets; one per account label (suffix = label uppercased).
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_ACCOUNTS=citylogix
MS_REFRESH_TOKEN_CITYLOGIX=

# --- Asana ---
ASANA_PAT=
ASANA_WORKSPACE_GID=