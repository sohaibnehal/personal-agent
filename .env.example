# --- Database (Neon) ---
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Anthropic (for summarization) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail OAuth ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Personal accounts only — never a Citylogix account.
GMAIL_ACCOUNTS=personal
GMAIL_REFRESH_TOKEN_PERSONAL=

# --- Yahoo (IMAP, read-only) ---
# Create an app password at Yahoo Account Security → Generate app password.
# One email + app password per label in YAHOO_ACCOUNTS (suffix = label uppercased).
YAHOO_ACCOUNTS=personal
YAHOO_EMAIL_PERSONAL=
YAHOO_APP_PASSWORD_PERSONAL=

# --- Classification (optional) ---
# Defaults to Claude Haiku; set to compare another model.
CLASSIFIER_MODEL=
