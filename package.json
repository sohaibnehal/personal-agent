{
  "name": "briefing-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal morning briefing agent: pulls from Gmail, Outlook, Teams, Asana into a dashboard.",
  "scripts": {
    "agent": "tsx src/index.ts",
    "agent:gmail": "tsx src/index.ts --source gmail",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "auth:gmail": "tsx src/sources/gmail/auth.ts",
    "auth:outlook": "tsx src/sources/outlook/auth.ts",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.0",
    "googleapis": "^144.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
